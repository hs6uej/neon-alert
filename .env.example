PORT=3000
ADMIN_USER=admin
ADMIN_PASS=change-me-please
TRUST_PROXY=0
MM_PAIR_WAIT=15
MM_BOT_WAIT=40
MM_START_DELAY=5

# AI pictures for buildings / units (Admin > Structures / Units > "Draw").
# Key from https://aistudio.google.com/apikey - it stays on the server and is never sent to browsers.
# Leave empty to switch AI drawing off (uploading / hand drawing still works).
GEMINI_API_KEY=
# Must be a model that can OUTPUT images (text-only models such as gemini-*-flash-lite cannot draw)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
